# Local (SQLite) — path relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

AUTH_SECRET="generate-a-long-random-secret"
# Use 3010 so it does not collide with Grafana (default :3000)
AUTH_URL="http://localhost:3010"

